# Add these to the .env file at the route ROOT (the folder containing 01-fundamentals ... 07-production) — never commit that file.
# GEMINI_API_KEY and GEMINI_MODEL are already there from earlier exercises.

ZAI_API_KEY=your-zai-key-here
ZAI_MODEL=glm-4.5-flash

# Used by providers.py:
#   priority 1: glm-4.5-flash       @ https://api.z.ai/api/paas/v4      (ZAI_API_KEY, ZAI_MODEL)
#   priority 2: gemini-flash-latest  @ googleapis                        (GEMINI_API_KEY, GEMINI_3.0_MODEL)
# A provider is only added to the chain if its API key exists in .env.
